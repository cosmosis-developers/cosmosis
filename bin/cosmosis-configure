#!/usr/bin/env bash

# This script should be sourced, not executed, so the environment changes apply
# to the caller. The first line below is a csh/tcsh jump; bash/zsh just try and
# ignore the unavailable goto command.
false || goto cosmosis_csh >& /dev/null

# This checks whether the script was executed or sourced
# https://stackoverflow.com/questions/2683279/how-to-detect-if-a-script-is-being-sourced
([[ -n $ZSH_EVAL_CONTEXT && $ZSH_EVAL_CONTEXT =~ :file$ ]] || 
[[ -n $KSH_VERSION && $(cd "$(dirname -- "$0")" &&
printf '%s' "${PWD%/}/")$(basename -- "$0") != "${.sh.file}" ]] || 
[[ -n $BASH_VERSION ]] && (return 0 2>/dev/null)) && sourced=1 || sourced=0

# This script should only be sourced
if [[ "${sourced}" == "0" ]]
then
    echo "You must source this script to use it, not execute it:"
    echo "source cosmosis-configure"
    exit
fi


cmds=$(python -m cosmosis.configure --shell sh "$@")
retval=$?
if [ $retval -ne 0 ]
then
    exit
fi



eval "$cmds"
echo "Your shell is now configured to build the CosmoSIS standard library"
return 0 2>/dev/null || exit 0

cosmosis_csh:
eval `python -m cosmosis.configure --shell csh $*:q`
if ( $status == 0 ) then
    echo "Your shell is now configured to build the CosmoSIS standard library"
endif
